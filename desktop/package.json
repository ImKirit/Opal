{
  "name": "opal-desktop",
  "productName": "Opal",
  "version": "0.1.0",
  "private": true,
  "description": "Opal als Desktop-App. Laedt den Opal-Server in einem eigenen Fenster.",
  "author": "Kirit <main@kirit.xyz>",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.imkirit.opal",
    "productName": "Opal",
    "files": ["main.cjs", "preload.cjs", "offline.html", "opal.config.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Opal-Setup-${version}.${ext}" }
  }
}
