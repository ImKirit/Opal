# Opal Server. Kopie als server/.env anlegen. Die echte .env ist in .gitignore.

# Port des Node-Servers. 3130 war auf dem VPS am 21.09.2026 frei (3120 und 3135 sind belegt).
PORT=3130

# Nur auf dieser Adresse lauschen. Live: 127.0.0.1 (nginx davor). Leer = alle Adressen.
HOST=

# Die Adresse, unter der Spieler die Seite oeffnen. Entscheidet ueber Cookies (https = secure)
# und den Standard fuer die Discord-Redirect-URI.
# Lokal mit Vite-Dev-Server: http://localhost:5174
# Live: https://imkirit.dev/opal (der Pfad /opal wird automatisch zum Praefix fuer alle Routen,
# Cookies und Socket.IO. Der Client muss dazu passend mit npm run build:live gebaut sein.)
PUBLIC_URL=http://localhost:5174

# Discord OAuth2 (https://discord.com/developers/applications -> OAuth2).
# Leer lassen = Discord-Login ist aus, Gast-Login funktioniert trotzdem.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Muss exakt so im Discord-Portal unter "Redirects" eingetragen sein.
# Standard: ${PUBLIC_URL}/auth/discord/callback
DISCORD_REDIRECT_URI=

# Gaeste duerfen Solo, Unranked und private Lobbys spielen, aber kein Ranked.
ALLOW_GUESTS=true

# Optional: welche Bereiche im Ranked-Pool landen (Komma-Liste "paket/bereich").
# Leer = alle Bereiche des Pakets "allgemein".
RANKED_SECTIONS=

# Optional: Discord-IDs (Komma-Liste), die auf der Seite als "Owner" markiert werden.
# Bewusst per ID statt per Name, einen Namen koennte sich jeder Gast geben.
OWNER_DISCORD_IDS=

# Optional: Speicherort der SQLite-Datenbank (Standard: server/data)
DATA_DIR=
